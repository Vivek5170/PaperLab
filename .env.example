# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# The only secret the pipeline needs. Everything non-secret
# (model, endpoint, paths) lives in config.yaml.

# Meta API key for the extractor/indexer LLM calls.
META_API_KEY=sk-paste-your-key-here

# --- Optional overrides (defaults live in config.yaml) ---
# PHYSICS_ARCHIVE_DB=/data/physics_archive.db
# PHYSICS_OUTPUT_BASE=/data/Outputs
# PIPELINE_CONFIG=/path/to/config.yaml
# LLM_MODEL=muse-spark-1.3-contributor
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_USE_RESPONSES_API=false
# LLM_REASONING_EFFORT=low
# Rate-limit riding per model call: attempts, first backoff step (sec),
# cumulative wait ceiling (sec). Defaults wait out ~5 minutes of 429s.
# LLM_RETRY_MAX_ATTEMPTS=8
# LLM_RETRY_BASE_SEC=2.0
# LLM_RETRY_BUDGET_SEC=300.0
# Per-million-token prices in USD (see config.yaml pricing section).
# PRICE_INPUT=0.10
# PRICE_CACHE_READ=0.002
# PRICE_OUTPUT=0.20
# Admin display currency (INR or USD) and conversion rate (see config.yaml).
# CURRENCY_DEFAULT=INR
# USD_TO_INR=95.0
